USE_REDIS=0
MIN_FREE_DISK_BYTES=1073741824

# --- YouTube (optional) -----------------------------------------------------
# The Docker image self-hosts a POT (Proof-of-Origin Token) provider that yt-dlp
# uses automatically, so usually nothing is needed here. Extra levers if YouTube
# still blocks from the server's datacenter IP:
# YTDLP_COOKIES=/etc/secrets/cookies.txt
# YTDLP_PROXY=http://user:pass@host:port
# YTDLP_EXTRACTOR_ARGS=youtube:player_client=web_safari
