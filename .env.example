USE_REDIS=0
MIN_FREE_DISK_BYTES=1073741824

# --- YouTube (optional) -----------------------------------------------------
# The Docker image self-hosts a POT (Proof-of-Origin Token) provider that yt-dlp
# uses automatically, so usually nothing is needed here. The Dockerfile sets
# BGUTIL_POT_BASE_URL=http://127.0.0.1:4416 for you; you only set it yourself if
# the provider runs elsewhere.
#
# Check the deployed plumbing at GET /api/health — it reports whether the POT
# provider is answering and which yt-dlp version is installed.
#
# Extra levers if YouTube still blocks from the server's datacenter IP (a
# datacenter IP can be flagged regardless of the POT token; cookies or a
# residential proxy are the reliable escalations):
# YTDLP_COOKIES=/etc/secrets/cookies.txt
# YTDLP_PROXY=http://user:pass@host:port
# YTDLP_EXTRACTOR_ARGS=youtube:player_client=web_safari   # fully overrides the hardened defaults
